  {
    "id": "zh-001",
    "group": "draft",
    "expect": "draft",
    "input": "把 exports 里超过 30 天没改过的 zip 文件收起来，至少留 30 天再说。",
    "note": "年龄与保留期都明确，唯一缺省的是命名与目录条件，用 *.zip 表达。",
    "answer": {
      "kind": "draft",
      "dsl": {
        "dsl_version": 1,
        "scope_id": "exports",
        "action": "quarantine",
        "match": {
          "min_mtime_age_seconds": 2592000,
          "min_size_bytes": 0,
          "relative_dir_prefixes": [],
          "basename_patterns": ["*.zip"]
        },
        "except": { "relative_dir_prefixes": [], "basename_patterns": [] },
        "retention_seconds": 2592000
      }
    }
  },
